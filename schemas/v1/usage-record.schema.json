{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sekacorn/AIMeter/schemas/v1/usage-record.schema.json",
  "title": "AIMeter Usage Record v1",
  "type": "object",
  "required": ["schema_version", "record_id", "record_type", "start_time", "end_time", "model", "usage", "performance", "cost"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_id": { "type": "string", "minLength": 1 },
    "record_type": { "type": "string" },
    "start_time": { "type": "string", "format": "date-time" },
    "end_time": { "type": "string", "format": "date-time" },
    "source": { "type": "object" },
    "attribution": { "type": "object" },
    "model": {
      "type": "object",
      "required": ["provider", "requested_model", "hosting"],
      "properties": {
        "provider": { "type": "string" },
        "requested_model": { "type": "string" },
        "response_model": { "type": "string" },
        "hosting": { "type": "string" }
      }
    },
    "usage": { "type": "object" },
    "performance": { "type": "object" },
    "cost": { "type": "object" },
    "outcome": { "type": "object" },
    "correlation": { "type": "object" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
